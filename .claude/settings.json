{
  "statusLine": {
    "type": "command",
    "command": "node \"C:\\Hub\\Project\\aide\\hooks\\statusline.mjs\""
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:\\Hub\\Project\\aide\\hooks\\session.mjs\" session-start"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:\\Hub\\Project\\aide\\hooks\\session.mjs\" pre-compact"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:\\Hub\\Project\\aide\\hooks\\session.mjs\" stop"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:\\Hub\\Project\\aide\\hooks\\read-dedup.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:\\Hub\\Project\\aide\\hooks\\guard-bash.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:\\Hub\\Project\\aide\\hooks\\session.mjs\" state-size"
          }
        ]
      }
    ]
  }
}
